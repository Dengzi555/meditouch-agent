# server.py loads the project-root .env; managed API fields override launcher defaults.
# Local UI: bottom-left avatar -> API settings. Secrets are stored in plaintext in .env.
MED_AGENT_API_KEY=
MED_AGENT_BASE_URL=https://api.openai.com/v1
MED_AGENT_MODEL=gpt-4.1-mini
# Vision OCR: explicit image-capable model required; blank disables OCR (manual import still works).
MED_AGENT_VISION_MODEL=
MED_AGENT_ALLOW_KNOWLEDGE_CANDIDATES=1
# Independent vision provider: all three fields required; never reuse the text gateway implicitly.
MED_AGENT_VISION_BASE_URL=
MED_AGENT_VISION_API_KEY=
# Optional local cross-encoder. Download first with python -m meditouch.reranking.
MED_AGENT_RERANK=0
# Optional raw Cross-Encoder cutoff. Empty keeps all scored candidates.
MED_AGENT_RERANK_MIN_SCORE=
# Prefer eligible public evidence, then fill gaps from local RAG. Set to 0 for local-only.
MED_AGENT_PUBLIC_KNOWLEDGE=1
# Optional education sources. Set after obtaining provider access.
MED_AGENT_NHS_API_KEY=
MED_AGENT_SHOWAPI_APP_KEY=
# Disease details (546-3) use the ShowAPI membership plan.
MED_AGENT_SHOWAPI_DETAIL=0
# Optional official-site web search after local retrieval. Blank disables it.
MED_AGENT_DEEPSEEK_SEARCH_KEY=
# Unverified low-risk medical education after all evidence paths are exhausted.
MED_AGENT_GENERAL_HEALTH_FALLBACK=0
# Set to 0 to compare against the original combined supplement search.
MED_AGENT_PARALLEL_SUPPLEMENT=1
# Optional single-store inventory. Set both; DB must already exist. Opened read-only.
MED_AGENT_INVENTORY_DB=
MED_AGENT_INVENTORY_STORE_ID=
PORT=8765
